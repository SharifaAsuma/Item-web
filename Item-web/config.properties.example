# =====================================================================
#  所持品管理 設定ファイル(UTF-8で保存してください)
#  このファイルを書き換えたら、アプリを再起動すると反映されます。
#
#  ★ あなたが最初に書き換えるのは db.password だけです。
#  ★ このファイルをコピーして config.properties という名前にして使います。
# =====================================================================

# ---------------------------------------------------------------------
#  1. データベース接続 (MySQL / スキーマ i2c)
# ---------------------------------------------------------------------
db.url=jdbc:mysql://localhost:3306/i2c?serverTimezone=Asia/Tokyo&useSSL=false&allowPublicKeyRetrieval=true
db.user=root
# ★ ここに MySQL のパスワードを書いてください(= のあとに続けて)
db.password=

# ---------------------------------------------------------------------
#  2. テーブル名・列名の対応づけ (i2c.item)
#     ※ 列名にスペースが入っていても、そのまま書いて大丈夫です。
#     ※ すでに i2c.item があり、列名が違う場合は、ここを実際の列名に合わせてください。
# ---------------------------------------------------------------------
table=item
col.id=ID
col.name=ITEM_NAME
col.category=CATEGORY
col.location=LOCATION
col.purchase=PURCHASE_DATE
col.price=PRICE
col.store=SHOP_NAME
col.warranty=WARRANTY_DATE
col.note=ITEM_MEMO

# 手放した日の列。ここに日付が入っている所持品は、一覧から自動的に隠れます。
col.dispose=DISPOSAL_DATE

# true のとき、テーブルが無ければ起動時に自動で作ります(同梱の setup.sql と同じ内容)
auto.create.table=true

# ID列が自動採番(AUTO_INCREMENT)かどうか。
# false にすると、登録時に「いまの最大ID + 1」をこのアプリが振ります。
id.auto.increment=true

# ---------------------------------------------------------------------
#  3. カテゴリ
# ---------------------------------------------------------------------
categories=家電,衣類,本・書籍,日用品,趣味,文房具,未分類

# ---------------------------------------------------------------------
#  3.5. 購入店舗・保管場所の候補(あらかじめ出しておきたい名前。任意設定)
#     ここに書いていなくても、一度入力した値は次回から自動で候補に出ます。
# ---------------------------------------------------------------------
store.presets=Amazon,楽天市場,ヨドバシカメラ,ビックカメラ,ユニクロ,無印良品,IKEA
location.presets=自室,リビング,寝室,クローゼット,キッチン,玄関,収納

# ---------------------------------------------------------------------
#  4. Webサーバー
# ---------------------------------------------------------------------
server.host=localhost
server.port=8080

# 保証期限まで何日以内になったら黄色で警告するか
warning.days=30
